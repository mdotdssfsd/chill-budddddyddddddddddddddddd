-- Instant Farmest Routine (Executes the millisecond character appears)
local function runInstantFarmest(char)
    if not FarmestEnabled then return end

    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    local hum = char:WaitForChild("Humanoid", 10)
    if not hrp or not hum or not FarmestEnabled then return end

    local targetCFrame = CFrame.new(FarmestPad + Vector3.new(0, 1.5, 0))

    -- 1. INSTANT SNAP (Zero Delay - Frame 0)
    hrp.CFrame = targetCFrame
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    if farmestStatusLabel then
        farmestStatusLabel.Text = "Active -> " .. FarmestPadName
    end

    -- 2. ZERO-LATENCY HEARTBEAT PAD PIN (Locks character to spot through punches/physics)
    local startTime = os.clock()
    local heartbeatLock
    heartbeatLock = RunService.Heartbeat:Connect(function()
        if not FarmestEnabled or (os.clock() - startTime >= FarmestDelay) then
            if heartbeatLock then
                heartbeatLock:Disconnect()
                heartbeatLock = nil
            end
            return
        end
        if hrp and hum and hum.Health > 0 then
            hrp.CFrame = targetCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end)

    -- Wait exact death delay
    task.wait(FarmestDelay)

    if heartbeatLock then
        heartbeatLock:Disconnect()
        heartbeatLock = nil
    end

    -- 3. INSTANT DEATH TRIGGER
    if FarmestEnabled and hum and hum.Health > 0 then
        if farmestStatusLabel then
            farmestStatusLabel.Text = "Resetting for next round..."
        end
        forceResetCharacter()
    end
end

