    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local isToggled = defaultState
    local function setVisual(toggled, fireCallback)
        isToggled = toggled
        switch.BackgroundColor3 = isToggled and THEME.Accent or THEME.ToggleOff
        knob.BackgroundColor3 = isToggled and THEME.KnobOn or THEME.KnobOff
        knob.Position = isToggled and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)

        if isToggled then
            playToggleSound()
        end
        if fireCallback and callback then
            callback(isToggled)
        end
    end

    switch.MouseButton1Click:Connect(function()
        setVisual(not isToggled)
        if callback then callback(isToggled) end
    end)

    if hasKeybind then
        local keyBtn = Instance.new("TextButton")
        keyBtn.Size = UDim2.new(0, 34, 0, 14)
        keyBtn.Position = UDim2.new(1, -68, 0.5, -7)
