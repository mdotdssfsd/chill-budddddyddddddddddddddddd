local function toggleSpectate(target)
    local camera = workspace.CurrentCamera
    if not camera then return false end

    if SpectatingPlayer == target or not target then
        SpectatingPlayer = nil
        if spectateConnection then
            spectateConnection:Disconnect()
            spectateConnection = nil
        end
        local myChar = LocalPlayer.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if myHum then
            camera.CameraSubject = myHum
        end
        if spectateBtn then spectateBtn.Text = "Spectate Player" end
        playerActionStatus.Text = '<font color="rgb(135, 125, 130)">Spectate stopped</font>'
        playToggleSound()
        return false
    else
        SpectatingPlayer = target
        if spectateConnection then
            spectateConnection:Disconnect()
            spectateConnection = nil
        end

        local function updateSubject()
            if SpectatingPlayer and SpectatingPlayer.Character then
                local hum = SpectatingPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    camera.CameraSubject = hum
                end
            end
        end

        updateSubject()
        spectateConnection = SpectatingPlayer.CharacterAdded:Connect(function()
            task.wait(0.2)
            updateSubject()
        end)
        if spectateBtn then spectateBtn.Text = "Stop Spectating" end
        playerActionStatus.Text = '<font color="rgb(100, 220, 120)">Spectating: ' .. target.DisplayName .. '</font>'
        playToggleSound()
        return true
    end
end

local function teleportToPlayer(target)
    if not target or not target.Character then
        playerActionStatus.Text = '<font color="rgb(246, 92, 82)">Target has no character</font>'
        return
    end
    local targetHrp = target.Character:FindFirstChild("HumanoidRootPart")
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if targetHrp and myHrp then
        myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 3)
        myHrp.AssemblyLinearVelocity = Vector3.zero
        myHrp.AssemblyAngularVelocity = Vector3.zero
        playerActionStatus.Text = '<font color="rgb(100, 220, 120)">Teleported to ' .. target.DisplayName .. '</font>'
        playToggleSound()
    else
        playerActionStatus.Text = '<font color="rgb(246, 92, 82)">Cannot find RootPart</font>'
    end
end

local function flingPlayer(target)
    if isFlingingPlayer then return end
    if not target or not target.Character then
        playerActionStatus.Text = '<font color="rgb(246, 92, 82)">Target has no character</font>'
        return
    end
    local targetHrp = target.Character:FindFirstChild("HumanoidRootPart")
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not targetHrp or not myHrp or not myHum then
        playerActionStatus.Text = '<font color="rgb(246, 92, 82)">Characters not ready for fling</font>'
        return
    end

    isFlingingPlayer = true
    playerActionStatus.Text = '<font color="rgb(246, 92, 82)">Flinging: ' .. target.DisplayName .. '...</font>'
    local oldPos = myHrp.CFrame
    local startTime = os.clock()

    local flingLoop
    flingLoop = RunService.Heartbeat:Connect(function()
        if os.clock() - startTime > 1.8 or not target.Parent or not target.Character or not myChar.Parent then
            if flingLoop then
                flingLoop:Disconnect()
                flingLoop = nil
            end
            pcall(function()
                myHrp.AssemblyAngularVelocity = Vector3.zero
                myHrp.AssemblyLinearVelocity = Vector3.zero
                myHrp.CFrame = oldPos
            end)
            isFlingingPlayer = false
            playerActionStatus.Text = '<font color="rgb(100, 220, 120)">Fling finished!</font>'
            return
        end

        -- Keep HumanoidRootPart CanCollide = TRUE to hit and transfer momentum!
        for _, part in ipairs(myChar:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = false
            end
        end

        myHum.PlatformStand = false
        myHum:ChangeState(Enum.HumanoidStateType.Running)
        myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 0)
        myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        myHrp.AssemblyAngularVelocity = Vector3.new(0, 45000, 0)
    end)
end

