    upCorner.Parent = upBtn

    local uStroke = Instance.new("UIStroke")
    uStroke.Color = THEME.Border
    uStroke.Thickness = 1
    uStroke.Parent = upBtn

    local sliderTrack = Instance.new("Frame")
    sliderTrack.Size = UDim2.new(1, -52, 0, 5)
    sliderTrack.Position = UDim2.new(0, 26, 0, 24)
    sliderTrack.BackgroundColor3 = THEME.ToggleOff
    sliderTrack.BorderSizePixel = 0
    sliderTrack.ZIndex = 3
    sliderTrack.Parent = row

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = sliderTrack

    local trackStroke = Instance.new("UIStroke")
    trackStroke.Color = THEME.Border
    trackStroke.Thickness = 1
    trackStroke.Parent = sliderTrack

    local currentVal = defaultVal
    local initialPercent = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(initialPercent, 0, 1, 0)
    fill.BackgroundColor3 = THEME.Accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 3
    fill.Parent = sliderTrack

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = fill

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 4, 0, 11)
    knob.Position = UDim2.new(initialPercent, -2, 0.5, -5.5)
    knob.BackgroundColor3 = THEME.KnobOn
    knob.BorderSizePixel = 0
    knob.ZIndex = 3
    knob.Parent = sliderTrack

    local slKnobCorner = Instance.new("UICorner")
    slKnobCorner.CornerRadius = UDim.new(0, 2)
    slKnobCorner.Parent = knob

    local function setValue(val)
        val = math.clamp(val, minVal, maxVal)
        currentVal = val

        if step < 1 then
            valLabel.Text = string.format("%.2f", val) .. suffix
        else
            valLabel.Text = tostring(math.floor(val)) .. suffix
        end

        local visualPercent = (val - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(visualPercent, 0, 1, 0)
        knob.Position = UDim2.new(visualPercent, -2, 0.5, -5.5)

        if fireCallback ~= false and callback then callback(val) end
    end

    downBtn.MouseButton1Click:Connect(function()
        setValue(currentVal - step, true)
    end)

    upBtn.MouseButton1Click:Connect(function()
        setValue(currentVal + step, true)
    end)

    sliderTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local trackAbsPos = sliderTrack.AbsolutePosition.X
            local trackAbsSize = sliderTrack.AbsoluteSize.X
            local percent = math.clamp((input.Position.X - trackAbsPos) / trackAbsSize, 0, 1)
            local rawVal = minVal + (maxVal - minVal) * percent
            local steps = math.round((rawVal - minVal) / step)
            setValue(minVal + steps * step, true)
        end
    end)

    return setValue
end

