local function cyclePlayer(direction)
    local all = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(all, p)
        end
    end
    if #all == 0 then
        playerActionStatus.Text = '<font color="rgb(246, 92, 82)">No other players online</font>'
        return
    end
    local currentIdx = 1
    for i, p in ipairs(all) do
        if p == selectedTargetPlayer then
            currentIdx = i
            break
        end
    end
    local newIdx = currentIdx + direction
    if newIdx > #all then newIdx = 1 end
    if newIdx < 1 then newIdx = #all end
    selectTarget(all[newIdx])
end

