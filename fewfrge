local function createSnakeSegment(index, total)
    local seg = Instance.new("ImageLabel")
    seg.Name = "SnakePart_" .. index
    seg.AnchorPoint = Vector2.new(0.5, 0.5)
    local scaleFactor = 1 - (index / (total * 1.6))
    local sizePx = math.max(14, math.floor(32 * scaleFactor))
    seg.Size = UDim2.new(0, sizePx, 0, sizePx)
    seg.Position = UDim2.new(0.5, 0, 0.5, 0)
    seg.BackgroundTransparency = 1
    seg.Image = INTRO_SNAKE_LOGO_ID
    seg.ScaleType = Enum.ScaleType.Fit
    seg.ImageTransparency = math.clamp(0.05 + (index / total) * 0.5, 0, 0.8)
    seg.ZIndex = 51
    seg.Parent = LoadingFrame
    return seg
end

