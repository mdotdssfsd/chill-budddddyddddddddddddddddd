        local kbStroke = Instance.new("UIStroke")
        kbStroke.Color = THEME.Border
        kbStroke.Thickness = 1
        kbStroke.Parent = keyBtn

        local listening = false
        local connection = nil

        keyBtn.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true
            keyBtn.Text = "[ ... ]"
            keyBtn.TextColor3 = THEME.Accent

            connection = UserInputService.InputBegan:Connect(function(input, processed)
                if processed then return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    connection:Disconnect()
                    listening = false

                    if input.KeyCode == Enum.KeyCode.Escape then
                        keyBtn.Text = "[ - ]"
                        keyBtn.TextColor3 = THEME.TextMuted
                        if onKeybindChanged then onKeybindChanged(nil) end
                    else
                        local keyName = input.KeyCode.Name
                        keyBtn.Text = "[ " .. keyName .. " ]"
                        keyBtn.TextColor3 = THEME.TextPrimary
                        if onKeybindChanged then onKeybindChanged(input.KeyCode) end
                    end
                end
            end)
        end)
    end

    return setVisual
end

