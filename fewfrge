local function serverHop()
    hopStatusLabel.Text = '<font color="rgb(246, 92, 82)">Searching public servers...</font>'
    local placeId = game.PlaceId
    local currentJob = game.JobId
    local TS = game:GetService("TeleportService")

    task.spawn(function()
        local candidates = {}
        local success, result = pcall(function()
            local order = PreferGoodPing and "Asc" or "Desc"
            local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=" .. order .. "&limit=100"
            local bodyStr = nil
            if request then
                local res = request({Url = url, Method = "GET"})
                bodyStr = res and (res.Body or res.body)
            elseif http_request then
                local res = http_request({Url = url, Method = "GET"})
                bodyStr = res and (res.Body or res.body)
            elseif syn and syn.request then
                local res = syn.request({Url = url, Method = "GET"})
                bodyStr = res and (res.Body or res.body)
            else
                bodyStr = game:HttpGet(url)
            end
            if bodyStr then
                return HttpService:JSONDecode(bodyStr)
            end
        end)

        if success and result and result.data then
            for _, s in ipairs(result.data) do
                if typeof(s) == "table" and s.id and s.id ~= currentJob and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
                    table.insert(candidates, s)
                end
            end
        end

        if #candidates > 0 then
            table.sort(candidates, function(a, b)
                local diffA = math.abs(a.playing - TargetServerPlayers)
                local diffB = math.abs(b.playing - TargetServerPlayers)
                if diffA == diffB then
                    local pingA = a.ping or 100
                    local pingB = b.ping or 100
                    return PreferGoodPing and (pingA < pingB) or (pingA > pingB)
                end
                return diffA < diffB
            end)

            local chosen = candidates[1]
            hopStatusLabel.Text = '<font color="rgb(100, 220, 120)">Connecting: ' .. chosen.playing .. '/' .. chosen.maxPlayers .. ' players...</font>'
            playToggleSound()
            task.wait(0.5)
            TS:TeleportToPlaceInstance(placeId, chosen.id, LocalPlayer)
        else
            -- Guaranteed fallback: teleport to next public server instance
            hopStatusLabel.Text = '<font color="rgb(100, 220, 120)">Connecting to available server...</font>'
            playToggleSound()
            task.wait(0.5)
            pcall(function()
                TS:Teleport(placeId, LocalPlayer)
            end)
        end
    end)
end

