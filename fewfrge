-- Snake Slither Animation Loop
local startTime = os.clock()
local snakeConnection = nil

snakeConnection = RunService.RenderStepped:Connect(function()
    local t = os.clock() - startTime
    local currentVp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
    local vw, vh = currentVp.X, currentVp.Y

    for i, seg in ipairs(snakeGroup1) do
        local delayOffset = (i - 1) * 0.045
        local st = t - delayOffset
        local nx = 0.5 + 0.40 * math.sin(st * 2.2 + 0.5)
        local ny = 0.5 + 0.36 * math.sin(st * 3.3)
        seg.Position = UDim2.new(0, nx * vw, 0, ny * vh)
        seg.Rotation = (t * 120 + i * 16) % 360
    end

    for i, seg in ipairs(snakeGroup2) do
        local delayOffset = (i - 1) * 0.045
        local st = t - delayOffset
        local nx = 0.5 + 0.38 * math.cos(st * 1.9 - 0.7)
        local ny = 0.5 + 0.34 * math.sin(st * 2.6 + 1.2)
        seg.Position = UDim2.new(0, nx * vw, 0, ny * vh)
        seg.Rotation = -(t * 110 + i * 14) % 360
    end

    local pulseScale = 1 + 0.04 * math.sin(t * 3.5)
    CenterLogo.Size = UDim2.new(0, 150 * pulseScale, 0, 150 * pulseScale)
end)

