local isUIVisible = true

local function toggleUIVisibility()
    isUIVisible = not isUIVisible
    if isUIVisible then
        Main.Visible = true
        TweenService:Create(Main, TWEEN_SLOW, {
            Position = UDim2.new(0.5, 0, 0.5, 0),
            BackgroundTransparency = 0
        }):Play()
    else
        local hideTween = TweenService:Create(Main, TWEEN_SLOW, {
            Position = UDim2.new(0.5, 0, 0.5, 30),
            BackgroundTransparency = 1
        })
        hideTween:Play()
        hideTween.Completed:Connect(function()
            if not isUIVisible then
                Main.Visible = false
            end
        end)
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        if isSimulatingKey then return end

        if ZeroStruggleEnabled and input.KeyCode == Enum.KeyCode.G then
            if not isGHeld then
                isGHeld = true
                if startZeroStruggleLoop then
                    startZeroStruggleLoop()
                end
            end
        end

        if HitboxKey and input.KeyCode == HitboxKey then
            HitboxEnabled = not HitboxEnabled
            if updateHitboxVisual then
                updateHitboxVisual(HitboxEnabled)
            end
        end

        if PanicEnabled and PanicKey and input.KeyCode == PanicKey then
            triggerPanicLeave()
        end

        if SpinbotKey and input.KeyCode == SpinbotKey then
            if SpinbotMode == "Hold" then
                updateSpinPhysics(true)
            else
                updateSpinPhysics(not SpinbotActive)
            end
        end

        if input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.Z then
            toggleUIVisibility()
        end
    end
end)
UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if isSimulatingKey then return end

    if input.KeyCode == Enum.KeyCode.G then
