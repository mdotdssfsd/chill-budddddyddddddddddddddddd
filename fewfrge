local function copyOutfit(targetInput)
    task.spawn(function()
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end

            local cleaned = targetInput:gsub("%s+", "")
            local targetPlayer = nil
            local targetUserId = nil

            if #cleaned > 0 then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and (p.Name:lower() == cleaned:lower() or p.DisplayName:lower() == cleaned:lower()) then
                        targetPlayer = p
                        break
                    end
                end
            else
                local myHrp = char:FindFirstChild("HumanoidRootPart")
                if myHrp then
                    local closestDist = math.huge
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local d = (p.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude
                            if d < closestDist then
                                closestDist = d
                                targetPlayer = p
                            end
                        end
                    end
                end
            end

            for _, item in ipairs(char:GetChildren()) do
                if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
                    item:Destroy()
                end
            end

            if targetPlayer and targetPlayer.Character then
                for _, item in ipairs(targetPlayer.Character:GetChildren()) do
                    if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
                        item:Clone().Parent = char
                    end
                end
            else
                if tonumber(cleaned) then
                    targetUserId = tonumber(cleaned)
                else
                    local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(cleaned) end)
                    if ok and id then targetUserId = id end
                end

                if targetUserId then
                    local appModel = Players:GetCharacterAppearanceAsync(targetUserId)
                    if appModel then
                        for _, item in ipairs(appModel:GetChildren()) do
                            if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
                                item.Parent = char
                            end
                        end
                        appModel:Destroy()
                    end
                end
            end
        end)
    end)
end

