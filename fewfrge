local function getLiveStats(player)
    local stats = {
        Kills = 0,
        LunchMoney = 0,
        Respect = 0,
        Device = "PC"
    }

    local ls = player:FindFirstChild("leaderstats") or player:FindFirstChild("Leaderstats")
    if ls then
        for _, val in ipairs(ls:GetChildren()) do
            local n = val.Name:lower()
            if n:find("kill") or n:find("ko") or n:find("streak") then
                stats.Kills = val.Value
            elseif n:find("lunch") or n:find("money") or n:find("cash") or n:find("bucks") then
                stats.LunchMoney = val.Value
            elseif n:find("respect") or n:find("rep") or n:find("score") then
                stats.Respect = val.Value
            end
        end
    end

    for _, attr in ipairs({"Kills", "Lunch Money", "LunchMoney", "Respect", "Money", "Cash"}) do
        local a = player:GetAttribute(attr)
        if a then
            local n = attr:lower()
            if n:find("kill") then stats.Kills = a
            elseif n:find("lunch") or n:find("money") or n:find("cash") then stats.LunchMoney = a
            elseif n:find("respect") then stats.Respect = a end
        end
    end

    if player == LocalPlayer then
        if isMobile then
            stats.Device = "Mobile"
        elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
            stats.Device = "Console"
        else
            stats.Device = "PC"
        end
    else
        local devAttr = player:GetAttribute("Device") or player:FindFirstChild("Device") or player:FindFirstChild("Platform")
        if devAttr then
            stats.Device = tostring(typeof(devAttr) == "Instance" and devAttr.Value or devAttr)
        else
            stats.Device = "PC"
        end
    end

    return stats
end

